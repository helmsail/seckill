# 环境变量模板：仅列变量与填写说明，具体值在本地 .env 填写
# 默认按 docker-compose 容器网络填写（值为服务名）
# 本地/服务器统一全容器化：docker compose 通过 env_file 注入，容器内以环境变量生效
# 如需混合模式（应用在 IDE、中间件在容器），把地址改回 localhost 并保证端口映射

# ========== MySQL ==========
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USERNAME=
MYSQL_PASSWORD=

# ========== Redis ==========
REDIS_HOST=
REDIS_PORT=

# ========== Nacos 客户端（注册中心 + 配置中心，格式 host:port）==========
NACOS_ADDR=
NACOS_USERNAME=
NACOS_PASSWORD=

# ========== Nacos 服务端鉴权（docker compose 启动 Nacos 容器时使用）==========
# NACOS_AUTH_TOKEN 需为 base64 编码且解码后 ≥32 字节（示例：openssl rand -base64 48）
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=

# ========== RocketMQ NameServer（格式 host:port）==========
ROCKETMQ_ADDR=

# ========== JWT（gateway/support/admin/base 四个模块必须一致）==========
JWT_SECRET=
# 令牌有效期（毫秒），86400000 = 24 小时
JWT_EXPIRATION=

# ========== 模拟支付（support-server 说明文本，按前端/浏览器视角可达地址填写）==========
# 说明文本原样下发前端，非容器网络服务名
MOCK_PAY_CALLBACK_URL=
MOCK_PAY_STATUS_URL=

# ========== 服务端口（宿主映射与容器监听一致）==========
GATEWAY_PORT=
BASE_SERVER_PORT=
ADMIN_PORT=
JOB_PORT=
SERVICE_PORT=
PROCESSOR_PORT=
SUPPORT_PORT=

# ========== Dubbo 协议端口（仅容器网络内，无需宿主映射）==========
BASE_DUBBO_PORT=
SUPPORT_DUBBO_PORT=

# ========== 外部工具 ==========
# Sentinel 控制台（格式 host:port）
SENTINEL_DASHBOARD_ADDR=
# XXL-Job 调度中心
XXL_ADMIN_ADDR=
# XXL-Job executor（容器内回调端口 + 任务日志目录）
XXL_EXECUTOR_PORT=
XXL_EXECUTOR_LOGPATH=
