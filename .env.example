# ============================================================
# 秒杀系统 · 本地唯一配置源模板(单机全容器化;docker compose 自动读取 .env)
#   用法:cp .env.example .env 后按需修改;结构与云端 deploy/.env 对齐。
#   本模板入库;实际 .env 被 .gitignore 忽略。
# ============================================================
#
# 【A】本机标识 · 应用运行
# ============================================================
# 宿主内网 IP(⚠️ 必须为合法 IPv4;XXL 执行器回调以此拼接;雪花机器号派生依据)
HOST_IP=
# 本地 Docker VM 内存有限(约 8G):应用统一小堆;中间件各自的堆见【E】
JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m

# ============================================================
# 【B】凭据
# ============================================================
MYSQL_USERNAME=root
MYSQL_PASSWORD=
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
# Nacos 服务端鉴权(Token 需 base64 且解码后 ≥32 字节:openssl rand -base64 48)
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=seckill-auth-identity-key
NACOS_AUTH_IDENTITY_VALUE=seckill-auth-identity-value
# JWT(gateway/support/admin/base 四个模块必须一致)
JWT_SECRET=
JWT_EXPIRATION=86400000

# ============================================================
# 【C】地址(容器服务名,容器内互通)
# ============================================================
MYSQL_HOST=mysql
REDIS_HOST=redis
NACOS_ADDR=nacos:8848
ROCKETMQ_ADDR=rocketmq-namesrv:9876
SENTINEL_DASHBOARD_ADDR=sentinel-dashboard:8858
XXL_ADMIN_ADDR=http://xxl-job-admin:8080/xxl-job-admin
# 模拟支付说明文本(按浏览器视角可达地址;回调路径含渠道段 /callback/mock)
MOCK_PAY_CALLBACK_URL=http://localhost:18087/api/c/pay/callback/mock
MOCK_PAY_STATUS_URL=http://localhost:18087/api/c/order/status

# ============================================================
# 【D】端口(宿主映射与容器监听一致;改后同步【C】对应地址)
# ============================================================
GATEWAY_PORT=18080
BASE_SERVER_PORT=18081
ADMIN_PORT=18082
JOB_PORT=18083
SERVICE_PORT=18084
PROCESSOR_PORT=18085
SUPPORT_PORT=18086
WEB_PORT=18087
MYSQL_PORT=3306
REDIS_PORT=6379
# Dubbo 协议端口(仅容器网络内,无需宿主映射)
BASE_DUBBO_PORT=28081
SUPPORT_DUBBO_PORT=28080
# XXL 调度台与 Sentinel 面板
XXL_ADMIN_PORT=8080
SENTINEL_PORT=8858
# XXL 执行器(容器内回调端口 + 任务日志目录)
XXL_EXECUTOR_PORT=19999
XXL_EXECUTOR_LOGPATH=/data/applogs/xxl-job/jobhandler

# ============================================================
# 【E】JVM(中间件各自堆;应用统一堆见【A】的 JAVA_TOOL_OPTIONS)
# ============================================================
NACOS_JVM_XMS=256m
NACOS_JVM_XMX=512m
NAMESRV_JAVA_OPT_EXT=-Xms256m -Xmx256m
BROKER_JAVA_OPT_EXT=-Xms512m -Xmx512m
SENTINEL_JAVA_OPTS=-Xmx384m

# ============================================================
# 【F】运行 · 网关限流(单实例 = 总目标)
# ============================================================
GATEWAY_QPS_SERVICE=6000
GATEWAY_QPS_READ=12000
GATEWAY_QPS_ADMIN=500

# ============================================================
# 【G】选配 · 支付宝沙箱(取消注释并填四要素才启用;不启用则仅 mock 渠道可用)
# ============================================================
# ⚠️ 只能整段启用/禁用:留空值(如 ALIPAY_APP_ID=)会被视为已配置导致渠道误装配
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_NOTIFY_URL=
# ALIPAY_GATEWAY_URL=
