# 环境变量模板：默认按 docker-compose 容器网络填写（值为服务名）
# 本地/服务器统一全容器化：docker compose 通过 env_file 注入，容器内以环境变量生效
# 如需混合模式（应用在 IDE、中间件在容器），把地址改回 localhost 并保证端口映射

# ========== MySQL ==========
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# ========== Redis ==========
REDIS_HOST=redis
REDIS_PORT=6379

# ========== Nacos 客户端（注册中心 + 配置中心，格式 host:port）==========
NACOS_ADDR=nacos:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# ========== Nacos 服务端鉴权（docker compose 启动 Nacos 容器时使用）==========
# NACOS_AUTH_TOKEN 需为 base64 编码且解码后 ≥32 字节（示例：openssl rand -base64 48）
NACOS_AUTH_TOKEN=dG9rZW50b2tlbnRva2VudG9rZW50b2tlbnRva2VudG9rZW4=
NACOS_AUTH_IDENTITY_KEY=seckill-auth-identity-key
NACOS_AUTH_IDENTITY_VALUE=seckill-auth-identity-value

# ========== RocketMQ NameServer（格式 host:port）==========
ROCKETMQ_ADDR=rocketmq-namesrv:9876

# ========== JWT（gateway/support/admin/base 四个模块必须一致）==========
JWT_SECRET=seckill-jwt-secret-key-must-be-at-least-256-bits-long!!
# 令牌有效期（毫秒），86400000 = 24 小时
JWT_EXPIRATION=86400000

# ========== 网关路由目标（容器网络服务名）==========
SECKILL_SERVICE_HOST=seckill-service
SECKILL_ADMIN_HOST=seckill-admin

# ========== 外部工具 ==========
# Sentinel 控制台（格式 host:port）
SENTINEL_DASHBOARD_ADDR=sentinel-dashboard:8858
# XXL-Job 调度中心
XXL_ADMIN_ADDR=http://xxl-job-admin:8080/xxl-job-admin
