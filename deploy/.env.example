# ============================================================
# 秒杀系统 · 云端唯一配置源模板(scripts/*.py 与 deploy/k6/*.js 均自动读取 .env)
#   用法:cp .env.example .env 后填值;本模板入库,实际 .env 被 .gitignore 忽略
#   修改后生效:python scripts/deploy_push.py all(重发配置)→ restart/up;k6 由 bench 自动重推
# ============================================================
#
# 【A】重建与换机 · 节点表(公网IP,内网IP)
# ============================================================
NODE_WEB=
NODE_GW1=
NODE_GW2=
NODE_GW3=
NODE_SVC1=
NODE_SVC2=
NODE_SVC3=
NODE_BASE1=
NODE_BASE2=
NODE_BASE3=
NODE_BASE4=
NODE_MIXPS=
NODE_REDIS=
NODE_MIXMQ=
NODE_MYSQL=

# 【A2】角色表:部署布局(分发/拉镜像/启动/重启/检测 共用)
#   格式:角色=compose文件列表|附属文件列表|env覆盖(K=V,…)|远端目录
ROLE_WEB=docker-compose.web.yml|nginx.conf,nginx-main.conf||/root/seckill
ROLE_GW1=docker-compose.gateway.yml|||/root/seckill
ROLE_GW2=docker-compose.gateway.yml|||/root/seckill
ROLE_GW3=docker-compose.gateway.yml|||/root/seckill
ROLE_SVC1=docker-compose.service.yml|||/root/seckill
ROLE_SVC2=docker-compose.service.yml|||/root/seckill
ROLE_SVC3=docker-compose.service.yml|||/root/seckill
ROLE_BASE1=docker-compose.base.yml|log4j2-quiet.xml|IMAGE_TAG=v2.1-w0|/root/seckill
ROLE_BASE2=docker-compose.base.yml|log4j2-quiet.xml|IMAGE_TAG=v2.1-w1,BASE1_SNOWFLAKE_ID=116|/root/seckill
ROLE_BASE3=docker-compose.base.yml|log4j2-quiet.xml|IMAGE_TAG=v2.1-w2,BASE1_SNOWFLAKE_ID=126|/root/seckill
ROLE_BASE4=docker-compose.base.yml|log4j2-quiet.xml|IMAGE_TAG=v2.1-w3,BASE1_SNOWFLAKE_ID=136|/root/seckill
ROLE_MIXPS=docker-compose.mixPS.yml|||/root/seckill
ROLE_REDIS=docker-compose.redis.yml|||/root/seckill
ROLE_MIXMQ=docker-compose.mixMQ.yml|broker.conf||/root/seckill
ROLE_MYSQL=docker-compose.mysql.yml|initdb/seckill-init.sql,initdb/xxl-job-base.sql,initdb/xxl-job-init.sql||/root/seckill
# 压测机(非生产;8C16G,跑 4000 档足够)
K6_PUB=
K6_PRIV=
# 压测机脚本目录
K6_DIR=/root/k6

# ============================================================
# 【B】测试对象 · 活动/SKU/账号(冒烟与压测共用;种子见 initdb)
# ============================================================
SECKILL_ACTIVITY_NO=LT-LOADTEST-001
# SKU 列表:skuNo:价格(逗号分隔;价格用于支付回调金额核对;与 initdb 种子一致)
SECKILL_SKUS=
# 账号池(与实际种子一致:lt00001~lt100000)
USER_COUNT=100000
USER_PREFIX=lt
USER_PASSWORD=

# ============================================================
# 【C】压测 · 参数
# ============================================================
# 压测目标(经 web 的 nginx;单组件定位可直连 http://<gw 内网IP>:18080)
# ⚠️ 无需手填:推送压测机时按节点表自动替换为当前 web 内网
BASE_URL=
# 每秒秒杀提交数 / 压测时长
SECKILL_RATE=4000
DURATION=3m
# 秒杀成功后按比例模拟支付(0=关,1=全付;真实秒杀"抢到即付"建议 0.95)
PAY_RATIO=0.95
# k6 预分配 VU(需 ≥ 速率×迭代时长;4000 档留 22000)
PRE_VUS=22000
# k6 VU 上限(防膨胀压垮压测机;需 ≥ 速率×迭代时长,4000 档实测 ~4.1 万)
MAX_VUS=45000
# 混合读流量(0=关;>0 按比例插入浏览请求)
BROWSE_RATE=0
BROWSE_PRE_VUS=20
BROWSE_MAX_VUS=100
# 就绪与运行节奏(k6;一般不用改)
SETUP_TIMEOUT=25m
READY_TIMEOUT_S=1200
PROBE_INTERVAL_S=10
ITER_SLEEP_S=1.2
SAMPLE_POLL_RATE=0.01
POLL_WAIT_S=2
ORDER_WAIT_MS=3000
ORDER_POLL_S=0.3

# ============================================================
# 【D】冒烟 · 参数
# ============================================================
# 活动 PENDING 时,把开始时间提前的秒数
ADVANCE_SECONDS=60
# 等待"库存预热 + ACTIVE"的上限(秒)
SMOKE_MAX_WAIT=480

# ============================================================
# 【E】部署 · 凭据(本文件不入库;如泄露请全量更换)
# ============================================================
SSH_PASSWORD=
# ACR 登录(阿里云容器镜像服务个人版;控制台"访问凭证"所设)
ACR_USERNAME=
ACR_PASSWORD=
# MySQL
MYSQL_USERNAME=root
MYSQL_PASSWORD=
# Nacos(服务端默认用户密码无法由 .env 注入修改;内网隔离下可接受)
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
# JWT / Nacos 鉴权(生成方式:openssl rand -base64 48,解码后 ≥32 字节)
JWT_SECRET=
JWT_EXPIRATION=86400000
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=seckill-auth-identity-key
NACOS_AUTH_IDENTITY_VALUE=seckill-auth-identity-value

# ============================================================
# 【F】部署 · 镜像(阿里云 ACR 个人版实例)
# ============================================================
# 公网域名(构建机推送用):crpi-vclagfc2g0ebwkes.cn-hangzhou.personal.cr.aliyuncs.com
# 同地域 ECS 用 -vpc 内网域名(更快、免公网流量):
IMAGE_REGISTRY=
# ⚠️ 多 base 实例必须用"主键变体"(base-1=v2.1-w0 … base-4=v2.1-w3,由 deploy_push 自动按角色覆盖)
IMAGE_TAG=v1.0
# 秒杀消费者专用镜像(200 线程版)
PROCESSOR_IMAGE_TAG=v1.2

# ============================================================
# 【G】部署 · 地址(发给各机、注入容器;推送时按节点表自动替换,无需手改)
# ============================================================
# 本机内网 IP(每台不同;下发时逐台替换)
HOST_IP=
MYSQL_HOST=
REDIS_HOST=
NACOS_ADDR=
SENTINEL_DASHBOARD_ADDR=
ROCKETMQ_ADDR=
XXL_ADMIN_ADDR=
# 模拟支付说明文本(前端展示用,指向 web;回调路径含渠道段 /callback/mock)
MOCK_PAY_CALLBACK_URL=
MOCK_PAY_STATUS_URL=
# 网关地址(供 web 的 nginx 模板 envsubst 注入;扩容=加 GATEWAYn_ADDR + nginx.conf 加 server 行)
GATEWAY1_ADDR=
GATEWAY2_ADDR=
GATEWAY3_ADDR=

# ============================================================
# 【H】运行 · 端口(宿主映射与容器监听一致)
# ============================================================
GATEWAY_PORT=18080
BASE_SERVER_PORT=18081
ADMIN_PORT=18082
JOB_PORT=18083
SERVICE_PORT=18084
PROCESSOR_PORT=18085
SUPPORT_PORT=18086
WEB_PORT=18087
MYSQL_PORT=3306
REDIS_PORT=6379
# Dubbo 协议端口(跨机必需宿主映射)
BASE_DUBBO_PORT=28081
SUPPORT_DUBBO_PORT=28080
# XXL 调度台与 Sentinel 面板;改端口需同步【G】的对应地址
XXL_ADMIN_PORT=8080
SENTINEL_PORT=8858
# XXL 执行器(job;回调端口)
XXL_EXECUTOR_PORT=19999
XXL_EXECUTOR_LOGPATH=/data/applogs/xxl-job/jobhandler
# 雪花/发号分配(base 的业务发号;表主键发号由镜像变体写死)
BASE1_SNOWFLAKE_ID=106
BASE2_SNOWFLAKE_ID=116

# ============================================================
# 【I】运行 · JVM(按机器规格 / QPS 档位调优)
# ============================================================
# --- 单服务 4C8G 机器(base / gateway / service)---
GATEWAY_JAVA_OPTS=-Xms2g -Xmx2g -XX:MaxDirectMemorySize=768m
BASE_JAVA_OPTS=-Xms2g -Xmx2g
SERVICE_JAVA_OPTS=-Xms2g -Xmx2g
PROCESSOR_JAVA_OPTS=-Xms1g -Xmx1g
# --- 混合/管理面机器(4C8G,内存较紧)---
SUPPORT_JAVA_OPTS=-Xms1g -Xmx1g
XXL_JAVA_OPTS=-Xmx512m
JOB_JAVA_OPTS=-Xms512m -Xmx512m
ADMIN_JAVA_OPTS=-Xms512m -Xmx512m
NAMESRV_JAVA_OPT_EXT=-Xms256m -Xmx256m
BROKER_JAVA_OPT_EXT=-Xms1g -Xmx1g
NACOS_JVM_XMS=256m
NACOS_JVM_XMX=512m
SENTINEL_JAVA_OPTS=-Xmx384m

# ============================================================
# 【J】运行 · 网关限流(每实例 = 总目标 ÷ 网关实例数;按 5000 提交目标配置)
# ============================================================
GATEWAY_QPS_SERVICE=6000
GATEWAY_QPS_READ=12000
GATEWAY_QPS_ADMIN=500

# ============================================================
# 【K】选配 · 支付宝沙箱(取消注释并填四要素才启用;不启用则仅 mock 渠道可用)
# ============================================================
# ⚠️ 不要只填空值(如 ALIPAY_APP_ID=)——空串会被视为已配置导致渠道误装配
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_NOTIFY_URL=
# ALIPAY_GATEWAY_URL=
