# ========== 秒杀系统 · 部署环境变量模板（deploy 部署包）==========
# 用法：每台服务器 cp .env.example .env 后填值；最少只需填「① 服务器地址」——
#       每台仅 HOST_IP 不同，其余各区所有台保持一致；本文件被 .gitignore 忽略。
#
# 角色速查（13×4C8G · 4000 QPS 生产档）：
#   G1~G2 网关 | S1~S3 业务服务 | B1~B3 核心 | P1~P2 消费（P2 附 xxl）
#   D1 MySQL+admin+web | D2 Redis+support | M1 基础设施(broker/namesrv/nacos/sentinel/job)

# ============================================================
# ① 服务器地址（必填：逐台填内网 IP）
# ============================================================

# 本机内网 IP（每台不同；服务注册 / Dubbo / XXL 执行器以此发布地址）
# ⚠️ 必须为合法 IPv4 且各台第四段互异（雪花 ID 机器号取第四段；填非 IP 值会导致建单 fail-fast）
HOST_IP=
# D1 数据库节点
MYSQL_HOST=
# D2 缓存节点
REDIS_HOST=
# M1 基础设施节点（RocketMQ/Nacos/Sentinel）
NACOS_ADDR=
SENTINEL_DASHBOARD_ADDR=
ROCKETMQ_ADDR=
# P2 消费节点（XXL 调度台所在；端口见 ④ XXL_ADMIN_PORT）
XXL_ADMIN_ADDR=
# 模拟支付说明文本（前端展示用，指向 D1 的 web——随服务器 IP 一起改；回调路径含渠道段 /callback/mock）
MOCK_PAY_CALLBACK_URL=
MOCK_PAY_STATUS_URL=

# ============================================================
# ② 镜像仓库（阿里云 ACR 个人版实例）
# ============================================================
# 例：crpi-xxxx.cn-hangzhou.personal.cr.aliyuncs.com/你的命名空间
# 服务器为同地域 ECS 时可用 -vpc 内网域名（更快、免公网流量）
IMAGE_REGISTRY=
# 版本标签：建议版本号或 git sha；回滚 = 改回旧 tag 后重新 up
IMAGE_TAG=

# ============================================================
# ③ 安全与账号（⚠️ 上线必改；生成方式：openssl rand -base64 48，解码后 ≥32 字节）
# ============================================================
MYSQL_PASSWORD=
# Nacos 服务端默认用户密码无法由 .env 注入修改（保持默认；内网隔离下可接受，
# 如需更换：登录 Nacos 控制台改密后同步到这里）
NACOS_PASSWORD=nacos
JWT_SECRET=
NACOS_AUTH_TOKEN=
MYSQL_USERNAME=root
NACOS_USERNAME=nacos
# Nacos 鉴权签名对（服务端校验用；值保持默认即可）
NACOS_AUTH_IDENTITY_KEY=seckill-auth-identity-key
NACOS_AUTH_IDENTITY_VALUE=seckill-auth-identity-value
JWT_EXPIRATION=86400000

# ============================================================
# ④ 端口（宿主映射与容器监听一致，一般不用改）
# ============================================================
GATEWAY_PORT=18080
BASE_SERVER_PORT=18081
ADMIN_PORT=18082
JOB_PORT=18083
SERVICE_PORT=18084
PROCESSOR_PORT=18085
SUPPORT_PORT=18086
WEB_PORT=18087
MYSQL_PORT=3306
REDIS_PORT=6379
# Dubbo 协议端口（跨机必需宿主映射，compose 已配好）
BASE_DUBBO_PORT=28081
SUPPORT_DUBBO_PORT=28080
# XXL 调度台（P2）与 Sentinel 面板（M1）；改端口需同步 ① 的对应地址
XXL_ADMIN_PORT=8080
SENTINEL_PORT=8858
# XXL 执行器（M1 的 job；回调端口与 compose 映射一致）
XXL_EXECUTOR_PORT=19999
XXL_EXECUTOR_LOGPATH=/data/applogs/xxl-job/jobhandler

# ============================================================
# ⑤ JVM 参数（按机器规格 / QPS 档位调优时填；不填 = 用各 compose 内默认值）
# ============================================================
# GATEWAY_JAVA_OPTS=-Xms3g -Xmx3g -XX:MaxDirectMemorySize=1g
# BASE_JAVA_OPTS=-Xms3g -Xmx3g
# PROCESSOR_JAVA_OPTS=-Xms2560m -Xmx2560m
# SUPPORT_JAVA_OPTS=-Xms1536m -Xmx1536m
# ADMIN_JAVA_OPTS=-Xms1g -Xmx1g
# JOB_JAVA_OPTS=-Xms1g -Xmx1g
# XXL_JAVA_OPTS=-Xmx1g
# NAMESRV_JAVA_OPT_EXT=-Xms256m -Xmx256m
# BROKER_JAVA_OPT_EXT=-Xms1g -Xmx1g
# NACOS_JVM_XMS=256m
# NACOS_JVM_XMX=512m
# SENTINEL_JAVA_OPTS=-Xmx512m
# （service 用 JDK 默认堆，未参数化；需要时在 service.yml 显式加 JAVA_TOOL_OPTIONS）

# ============================================================
# ⑥ 网关限流阈值（每实例 = 总目标 ÷ 网关实例数；G1~G2 共 2 实例）
# ============================================================
# 总容量或网关实例数变化时同步调整（2 实例 → 交易 6000/2、读 12000/2、运营端 500）
GATEWAY_QPS_SERVICE=3000
GATEWAY_QPS_READ=6000
GATEWAY_QPS_ADMIN=500

# ============================================================
# ⑦ 压测 k6（deploy/k6/seckill-loadtest.js 自动读取）
# ============================================================
# 压测目标（推荐经 web 的 nginx 分摊到 2 台网关：http://<D1 内网IP>:18087；
#           单实例定位用直连：http://<Gx 内网IP>:18080；本地联调 http://localhost:18080）
BASE_URL=
# 每秒秒杀提交数 / 压测时长（5000 = 极限档，4000 = 生产档）
SECKILL_RATE=
DURATION=
# 秒杀成功后按比例模拟支付（0=关，1=全付）
PAY_RATIO=

# ============================================================
# ⑧ 选配：支付宝沙箱渠道（取消注释并填四要素才启用；不启用则仅 mock 渠道可用）
# ============================================================
# ⚠️ 不要只填空值（如 ALIPAY_APP_ID=）——空串会被视为已配置导致渠道误装配
# 沙箱应用与密钥：open.alipay.com 控制台（沙箱环境）创建应用后获取（应用私钥 PKCS8 Base64，可含 PEM 头尾，自动清洗）
# 异步通知地址（须公网可达；本地联调用内网穿透映射到 D1 的 web 的 /api/c/pay/callback/alipay）
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_NOTIFY_URL=
# 网关地址（缺省=沙箱；生产改 https://openapi.alipay.com/gateway.do）
# ALIPAY_GATEWAY_URL=
