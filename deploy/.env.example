# ========== 秒杀系统 · 部署环境变量模板（deploy 部署包）==========
# 用法：每台服务器 cp .env.example .env 后填写；结构：① 常用修改区 → ② 一般不用动。
# 角色台速查：台1 数据(MySQL/Redis) | 台2~4 service | 台5 核心(base/processor/support)
#             台6 中间件(Nacos/MQ/Sentinel/XXL) | 台7 管理(admin/job) | 台8 入口(gateway/web)

# ============================================================
# ① 常用修改区
# ============================================================

# ---------- 服务器 IP（云服务器的内网 IP）----------
# 本机 IP（每台不同：服务注册 / Dubbo / XXL 执行器以此发布地址）
HOST_IP=
# 台 1（数据）
MYSQL_HOST=
REDIS_HOST=
# 台 6（中间件）
NACOS_ADDR=
ROCKETMQ_ADDR=
SENTINEL_DASHBOARD_ADDR=
XXL_ADMIN_ADDR=
# 模拟支付说明文本（前端展示用，指向台 8 web——随服务器 IP 一起改）
MOCK_PAY_CALLBACK_URL=
MOCK_PAY_STATUS_URL=

# ---------- 镜像仓库（阿里云 ACR）----------
# 例（个人版实例）：crpi-xxxx.cn-hangzhou.personal.cr.aliyuncs.com/你的命名空间
# 服务器为同地域 ECS 时可用 -vpc 内网域名（更快、免公网流量）
IMAGE_REGISTRY=
# 版本标签：建议版本号或 git sha；回滚 = 改回旧 tag 后重新 up
IMAGE_TAG=

# ---------- 压测 k6（deploy/k6/seckill-loadtest.js 自动读取）----------
# 压测目标（本地联调 http://localhost:18080；服务器 http://<台8 IP>:18080）
BASE_URL=
# 每秒秒杀提交数 / 压测时长
SECKILL_RATE=
DURATION=
# 秒杀成功后按比例模拟支付（0=关，1=全付）
PAY_RATIO=

# ============================================================
# ② 一般不用动（保持默认即可）
# ============================================================

# ---------- 安全项（⚠️ 上线必改）----------
MYSQL_PASSWORD=
NACOS_PASSWORD=
JWT_SECRET=
# 生成方式：openssl rand -base64 48（解码后需 ≥32 字节）
NACOS_AUTH_TOKEN=

MYSQL_PORT=3306
MYSQL_USERNAME=root
REDIS_PORT=6379
NACOS_USERNAME=nacos
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
JWT_EXPIRATION=86400000

# 服务端口（宿主映射与容器监听一致，一般不用改）
GATEWAY_PORT=18080
BASE_SERVER_PORT=18081
ADMIN_PORT=18082
JOB_PORT=18083
SERVICE_PORT=18084
PROCESSOR_PORT=18085
SUPPORT_PORT=18086
WEB_PORT=18087

# Dubbo 协议端口（跨机必需宿主映射，compose 已配好）
BASE_DUBBO_PORT=28081
SUPPORT_DUBBO_PORT=28080

# XXL 执行器（回调端口与 docker-compose.management.yml 映射一致）
XXL_EXECUTOR_PORT=
XXL_EXECUTOR_LOGPATH=/data/applogs/xxl-job/jobhandler
